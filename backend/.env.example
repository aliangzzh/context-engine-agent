# Backend configuration. Copy to .env and fill in what you have.

# --- LLM (chat) backend ---
# Leave DASHSCOPE_API_KEY empty to fall back to the offline FakeModel.
DASHSCOPE_API_KEY=
QWEN_CHAT_MODEL=qwen3-max
QWEN_EMBED_MODEL=text-embedding-v4

# --- Retrieval backend: auto | bm25 | dashscope ---
# auto picks dashscope (embedding similarity) when DASHSCOPE_API_KEY is set,
# otherwise bm25 (offline).
RETRIEVAL_BACKEND=auto

# --- 文档切分（RAG 效果调优时可切策略做对比实验） ---
# sentence = 按句/段边界打包（默认，语义更完整）
# fixed    = 定长滑窗（baseline）
CHUNK_STRATEGY=sentence
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- 上传 ---
MAX_UPLOAD_BYTES=2097152

# --- 日志 ---
# DEBUG | INFO | WARNING | ERROR，结构化输出到 stderr（每行带 request_id）
LOG_LEVEL=INFO

# --- Context Engine ---
# 把预算调小（例如 100）可以直观看到裁剪与 over_budget 上报的行为。
CONTEXT_TOKEN_BUDGET=4096
HISTORY_MAX_TURNS=8
HISTORY_SUMMARY_TOKENS=300
TOP_K=3

# --- Storage (对话历史) ---
# 留空 = 本地 SQLite（stdlib，离线零依赖，backend/data/chat_history/history.db）
# MySQL: mysql+pymysql://user:pass@host:3306/dbname  （需 pip install pymysql）
DATABASE_URL=

# --- Cache (检索结果缓存) ---
# 留空 = 进程内 LRU（stdlib，离线零依赖）
# Redis: redis://localhost:6379/0                    （需 pip install redis）
REDIS_URL=
CACHE_TTL=120
CACHE_MAXSIZE=256

# --- Fine-tuning ---
FINE_TUNE_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
MAX_SEQ_LEN=512
USE_4BIT=true

# --- Server ---
PORT=8000
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
